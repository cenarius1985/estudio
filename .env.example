# ============================================================
# Estudio — configuración (cópiala a .env o déjala vacía y
# configura TODO desde el panel: Ajustes → Configuración).
# Los valores del PANEL (base de datos) tienen prioridad sobre
# este archivo cuando están seteados.
# El coordinador.py genera este .env con claves aleatorias.
# ============================================================

# ---------- Base de datos ----------
POSTGRES_USER=estudio
POSTGRES_PASSWORD=cambia-me-generada
POSTGRES_DB=estudio
DB_PORT=5433

# ---------- Redis ----------
REDIS_PORT=6380

# ---------- Puertos ----------
API_PORT=8600
FRONTEND_PORT=8601

# ---------- Panel ----------
# Contraseña inicial del panel (cambiable en Ajustes → Seguridad)
ADMIN_PASSWORD=cambia-me-admin
# URL pública del frontend (para los botones del correo)
FRONTEND_URL=http://localhost:8601

# ---------- Correo (Brevo SMTP) ----------
# Opcional aquí: puedes configurarlo desde el panel (Ajustes → Correo Brevo)
# con el tutorial incluido. Consigue tus claves en https://www.brevo.com/
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Destinatarios de los tips diarios (coma-separados); también en el panel
TIPS_TO=
# Hora local del envío diario (HH:MM, zona del servidor)
TIPS_HORA=07:30

# ---------- Tips ----------
TIPS_UMBRAL_DEDUPE=0.90
TIPS_REINTENTOS=3

# ---------- LLM (cualquier API OpenAI-compatible) ----------
# Endpoint primario: el servicio bonsai del compose (perfil gpu) o uno externo
LLM_BASE_URL=http://bonsai:8080/v1
# Fallback opcional (p. ej. Ollama: http://host.docker.internal:11434/v1)
LLM_FALLBACK_URL=
LLM_MODEL=ternary-bonsai-2-27b
# API key para proveedores de pago (OpenAI, DeepSeek, Kimi, Gemini, Claude,
# Groq, OpenRouter) — también configurable en el panel (Ajustes → LLM)
LLM_API_KEY=

# ---------- Servicio bonsai (perfil gpu) ----------
BONSAI_GGUF=Ternary-Bonsai-2-27B-PTQ1_0.gguf
BONSAI_HF_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
BONSAI_CTX=8192
BONSAI_NGL=99
BONSAI_THINKING=0
# Carpeta host donde vive el GGUF (~5.7 GB; se descarga la primera vez)
BONSAI_MODELS_DIR=./bonsai/models

# ---------- Embeddings ----------
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_DIM=1024
# Grafo: extraer tripletas con el LLM (1 llamada por documento; lento)
GRAFO_LLM=0

# ---------- Fuentes ----------
# Ruta HOST de tu carpeta de documentos (se monta en /fuentes dentro de los
# contenedores). Default: ./fuentes del proyecto. También puedes cambiar la
# carpeta usada por el escaneo desde el panel (dentro del contenedor).
RUTA_TESIS=./fuentes
RUTA_FUENTES=/fuentes
EXCLUDE_DIRS=.git,node_modules,__pycache__,.venv,build
MAX_ARCHIVO_BYTES=209715200
