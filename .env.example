# ============================================================
# Estudio Doctorado — configuración (copiar a .env y completar)
# El coordinador.py puede generar este archivo automáticamente.
# ============================================================

# ---------- Base de datos ----------
POSTGRES_USER=estudio
POSTGRES_PASSWORD=cambia-me-generada
POSTGRES_DB=estudio
DB_PORT=5433

# ---------- Redis ----------
REDIS_PORT=6380

# ---------- Puertos ----------
API_PORT=8600
FRONTEND_PORT=8601

# ---------- Panel ----------
# Contraseña del panel (login). Cámbiala.
ADMIN_PASSWORD=cambia-me-admin
# URL pública del frontend (para los botones del correo)
FRONTEND_URL=http://localhost:8601

# ---------- Correo (SMTP Brevo — mismos valores que reportesDiariosGes) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Destinatarios de los tips diarios (separados por coma)
TIPS_TO=
# Hora local del envío diario (HH:MM, zona America/Santiago)
TIPS_HORA=07:30

# ---------- Tips ----------
# Umbral de similitud coseno para considerar un tip duplicado (0..1)
TIPS_UMBRAL_DEDUPE=0.90
# Reintentos con otro tema antes de reutilizar un tip duplicado
TIPS_REINTENTOS=3

# ---------- LLM (Bonsai, patrón whispertext rama gpu) ----------
# Endpoint primario: servicio bonsai del compose (perfil gpu)
LLM_BASE_URL=http://bonsai:8080/v1
# Fallback opcional si Bonsai no está (p. ej. ollama local)
# LLM_FALLBACK_URL=http://host.docker.internal:4686/v1
LLM_MODEL=ternary-bonsai-2-27b

# ---------- Servicio bonsai (perfil gpu) ----------
BONSAI_GGUF=Ternary-Bonsai-2-27B-PTQ1_0.gguf
BONSAI_HF_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
BONSAI_CTX=8192
BONSAI_NGL=99
BONSAI_THINKING=0
# Carpeta host con el GGUF (compartida con whispertext para no duplicar 5.7 GB)
BONSAI_MODELS_DIR=E:/GitHub/whispertext/backend/bonsai/models

# ---------- Embeddings ----------
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_DIM=1024
# Grafo: extraer tripletas con el LLM (1 llamada Bonsai por documento; frena
# la ingesta masiva). El grafo por diccionario siempre se construye.
GRAFO_LLM=0

# ---------- Ingesta ----------
# Ruta de las fuentes montada en el contenedor (no cambiar salvo reestructura)
RUTA_FUENTES=/fuentes
# Subcarpetas de Proyecto-Tesis que se excluyen del escaneo (separadas por coma)
EXCLUDE_DIRS=.git,node_modules,__pycache__,.venv,Tensorflowmri,build
# Tamaño máximo de archivo a indexar (bytes; 200 MB)
MAX_ARCHIVO_BYTES=209715200
